# Copy to .env. All values optional; without LLM_* the app uses rule-based extraction.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
FLASK_SECRET_KEY=
MAX_UPLOAD_MB=5
AMOUNT_THRESHOLD=10000
TOLERANCE=0.02
# HTTP Basic Auth for the whole UI (/health stays open). Leave empty only for local testing.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
